# 공개 브랜치용 제외 목록
#
# 이 브랜치는 AWS Amplify Hosting 배포에 필요한 파일만 담습니다.
# 아래 경로는 로컬 작업 브랜치에만 있고 이 브랜치로 올라오지 않습니다.
# 실수로 `git add .` 를 해도 들어가지 않게 여기에 적어 둡니다.

# AWS 강사용 교재 원본과 그에 가까운 파생물.
# 인증 강사에게 라이선스된 자료이므로 공개 저장소에 넣지 않습니다.
Contents/

# 사실 검증 파이프라인과 근거 기록.
# 교재 문구를 직접 인용한 항목이 많아 공개 대상에서 제외합니다.
pipeline/

# 콘텐츠 작성 규칙 (프로젝트 내부 문서)
.kiro/

# 로컬 백업 아카이브
backups/

# 빌드 산출물
webapp/dist/
webapp/node_modules/
webapp/deploy.zip
__pycache__/
*.pyc

# 배포에 쓰지 않는 개발용 스크립트.
# npm run build 는 check-tokens.mjs 만 호출합니다.
webapp/scripts/render-check.mjs
webapp/scripts/resolve-tokens.mjs

# Amplify 로컬 산출물.
# 배포 설정은 amplify.yml 과 customHttp.yml 두 개뿐이고 이 둘은 커밋합니다.
.amplify/
amplify_outputs*.json
amplifyconfiguration*.json

# 환경 변수와 자격 증명.
# Amplify 의 환경 변수는 콘솔에서 설정합니다.
.env
.env.*
*.pem
*.key

# 에디터
.vscode/
.idea/
*.swp

# 로그·OS·캐시
*.log
.DS_Store
webapp/.npm/
